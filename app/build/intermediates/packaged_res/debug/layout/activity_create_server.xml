<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#080808">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#080808" android:paddingStart="8dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btn_back"
            android:layout_width="42dp" android:layout_height="42dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FF6B00"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="┌─ NEW SERVER" android:textColor="#FF6B00"
            android:textSize="13sp" android:fontFamily="monospace"
            android:textStyle="bold" android:letterSpacing="0.1"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#FF6B00"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- ── SERVER NAME ───────────────────────────── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NAME" android:textColor="#FF6B00"
                android:textSize="9sp" android:fontFamily="monospace"
                android:letterSpacing="0.15" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/et_name"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:background="@drawable/input_field"
                android:textColor="#E0E0E0" android:textSize="14sp"
                android:fontFamily="monospace"
                android:hint="e.g. MySurvival"
                android:textColorHint="#222222"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:inputType="text" android:singleLine="true"
                android:layout_marginBottom="12dp"/>

            <!-- ── ADDRESS PREVIEW ──────────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/preview_bg"
                android:padding="10dp" android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CONNECT ADDRESS" android:textColor="#7A3300"
                    android:textSize="8sp" android:fontFamily="monospace" android:letterSpacing="0.15"/>
                <TextView android:id="@+id/tv_address_preview"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="yourserver.kodanetwork.eu"
                    android:textColor="#FF6B00" android:textSize="13sp"
                    android:fontFamily="monospace" android:textStyle="bold"
                    android:layout_marginTop="3dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="// velocity: kodanetwork.eu"
                    android:textColor="#2A1000" android:textSize="8sp"
                    android:fontFamily="monospace" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- ── SERVER TYPE ──────────────────────────── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TYPE" android:textColor="#FF6B00"
                android:textSize="9sp" android:fontFamily="monospace"
                android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/layout_type_btns"
                android:layout_width="match_parent" android:layout_height="38dp"
                android:orientation="horizontal" android:layout_marginBottom="16dp"/>

            <!-- ── VERSION ──────────────────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VERSION" android:textColor="#FF6B00"
                    android:textSize="9sp" android:fontFamily="monospace"
                    android:letterSpacing="0.15"/>
                <TextView android:id="@+id/tv_version_loading"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="…" android:textColor="#2A2A2A"
                    android:textSize="9sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <Spinner android:id="@+id/spin_version"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:background="@drawable/input_field"
                android:layout_marginBottom="16dp"/>

            <!-- ── RAM ─────────────────────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RAM" android:textColor="#FF6B00"
                    android:textSize="9sp" android:fontFamily="monospace"
                    android:letterSpacing="0.15"/>
                <TextView android:id="@+id/tv_ram_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FF6B00" android:textSize="13sp"
                    android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek_ram"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#FF6B00" android:thumbTint="#FF6B00"
                android:progressBackgroundTint="#151515"
                android:layout_marginBottom="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="512MB"
                    android:textColor="#1F1F1F" android:textSize="8sp" android:fontFamily="monospace"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="8GB" android:textColor="#1F1F1F"
                    android:textSize="8sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- ── PORT ───────────────────────────────── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PORT" android:textColor="#FF6B00"
                android:textSize="9sp" android:fontFamily="monospace"
                android:letterSpacing="0.15" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/et_port"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:background="@drawable/input_field"
                android:textColor="#E0E0E0" android:textSize="14sp"
                android:fontFamily="monospace" android:hint="25565"
                android:textColorHint="#222222"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:inputType="number" android:singleLine="true"
                android:layout_marginBottom="24dp"/>

            <!-- ── CREATE ─────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                style="@style/KodaButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="[  CREATE SERVER  ]"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
