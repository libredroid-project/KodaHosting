<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KODAHOSTING"
            android:textColor="@color/txt_primary"
            android:textStyle="bold"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mao-style home page ported natively. Manage Minecraft hosting, billing and account flows."
            android:textColor="@color/txt_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_login"
            style="@style/KodaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SIGN IN" />

        <Button
            android:id="@+id/btn_register"
            style="@style/KodaButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CREATE ACCOUNT" />

        <Button
            android:id="@+id/btn_checkout"
            style="@style/KodaButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CHECKOUT" />

        <Button
            android:id="@+id/btn_dashboard"
            style="@style/KodaButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ACCOUNT DASHBOARD" />

        <Button
            android:id="@+id/btn_server_manager"
            style="@style/KodaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OPEN SERVER MANAGER" />
    </LinearLayout>
</ScrollView>
