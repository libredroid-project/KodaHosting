        <item name="colorSurfaceDim">@color/m3_dark_surfaceDim</item>
        <item name="colorSurfaceBright">@color/m3_dark_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/m3_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_dark_surfaceContainerLow</item>
