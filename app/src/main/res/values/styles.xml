<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KodaNetwork" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#7A4E8C</item>
        <item name="colorPrimaryVariant">#4A5058</item>
        <item name="colorSecondary">#62727B</item>
        <item name="android:colorBackground">#050510</item>
        <item name="colorSurface">#050510</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnBackground">#E0E0E0</item>
        <item name="colorOnSurface">#E0E0E0</item>
        <item name="android:statusBarColor">#050510</item>
        <item name="android:navigationBarColor">#050510</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">#E0E0E0</item>
    </style>

    <!-- Primary orange filled, sharp corners -->
    <style name="KodaButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#7A4E8C</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">0dp</item>
        <item name="rippleColor">#4A5058</item>
    </style>

    <!-- Outlined orange, sharp corners -->
    <style name="KodaButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#62727B</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">#D6D6D6</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <!-- Danger red, sharp corners -->
    <style name="KodaButton.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#1A0000</item>
        <item name="android:textColor">#FF3333</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">#FF3333</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tab text style -->
    <style name="MonoTabText" parent="@android:style/TextAppearance">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
