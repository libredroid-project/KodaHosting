<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A0A0F">

    <!-- ┌─ TOP BAR ─────────────────────────────────────────────────────┐ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/header_bg"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:elevation="4dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="KODAHOSTING" android:textColor="#F0F0F0"
                android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:textStyle="bold" android:letterSpacing="0.08"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Minecraft Server Manager"
                android:textColor="#555566" android:textSize="11sp"
                android:fontFamily="sans-serif" android:layout_marginTop="1dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_server_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 SERVERS" android:textColor="#8A8A9A"
            android:textSize="11sp" android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06" android:layout_marginEnd="16dp"/>

        <TextView android:id="@+id/btn_debug_log"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LOG" android:textColor="#8A8A9A"
            android:textSize="12sp" android:fontFamily="sans-serif-medium"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView android:id="@+id/btn_settings"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚙" android:textColor="#8A8A9A"
            android:textSize="18sp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Orange accent line -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FF6B00"/>

    <!-- Subheader row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#0E0E16" android:paddingStart="20dp" android:paddingEnd="20dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SERVER NAME" android:textColor="#555566"
            android:textSize="10sp" android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"/>
        <TextView android:layout_width="60dp" android:layout_height="wrap_content"
            android:text="TYPE" android:textColor="#555566"
            android:textSize="10sp" android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"/>
        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
            android:text="RAM" android:textColor="#555566"
            android:textSize="10sp" android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"/>
        <TextView android:layout_width="60dp" android:layout_height="wrap_content"
            android:text="STATUS" android:textColor="#555566"
            android:textSize="10sp" android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1A1A24"/>

    <!-- Server list -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="80dp"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="8dp"/>

        <!-- Empty state -->
        <LinearLayout android:id="@+id/tv_empty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📦" android:textSize="48sp"
                android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/tv_no_servers"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="No Servers Yet" android:textColor="#8A8A9A"
                android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tv_tap_create"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tap the button below to create your first server"
                android:textColor="#555566"
                android:textSize="13sp" android:fontFamily="sans-serif"
                android:layout_marginTop="8dp" android:gravity="center"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom bar with FAB -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1A1A24"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#0E0E16" android:paddingStart="20dp" android:paddingEnd="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="kodanetwork.eu" android:textColor="#2A2A35"
            android:textSize="11sp" android:fontFamily="sans-serif"/>
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="＋  NEW SERVER"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.04"
            android:textSize="12sp"
            app:backgroundTint="#FF6B00"
            app:cornerRadius="12dp"
            app:elevation="6dp"/>
    </LinearLayout>

</LinearLayout>
