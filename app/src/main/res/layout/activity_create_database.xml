<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A0807">

    <!-- Header Container -->
    <LinearLayout android:id="@+id/top_bar_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0807" android:elevation="4dp">
        
        <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="20dp">
            <ImageButton android:id="@+id/btn_back"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FF6B00"
                android:scaleType="centerInside"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/new_database" android:textColor="#F0F0F0"
                android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:textStyle="bold" android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FF6B00"/>

    <ScrollView android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- DATABASE NAME -->
            <LinearLayout android:id="@+id/layout_name_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/database_name" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_name"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/input_field"
                    android:textColor="#F0F0F0" android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:hint="@string/database_name_hint"
                    android:textColorHint="#3A3A48"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:inputType="text" android:singleLine="true"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- DATABASE ENGINE -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/database_engine" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <RadioGroup
                    android:id="@+id/rg_engine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_mariadb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MariaDB"
                        android:textColor="#8A8A9A"
                        android:buttonTint="#FF6B00"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rb_redis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redis"
                        android:textColor="#8A8A9A"
                        android:buttonTint="#FF6B00"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#1A1A24" android:layout_marginBottom="24dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/database_port" android:textColor="#F0F0F0"
                android:textSize="11sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/et_port"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/input_field"
                android:textColor="#F0F0F0" android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:hint="@string/database_port_hint"
                android:textColorHint="#3A3A48"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:inputType="number" android:singleLine="true"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/database_username" android:textColor="#F0F0F0"
                android:textSize="11sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/et_username"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/input_field"
                android:textColor="#F0F0F0" android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:text="@string/database_username_default"
                android:textColorHint="#3A3A48"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:inputType="text" android:singleLine="true"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/database_password" android:textColor="#F0F0F0"
                android:textSize="11sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/et_password"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/input_field"
                android:textColor="#F0F0F0" android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:text="@string/database_password_default"
                android:textColorHint="#3A3A48"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:inputType="textVisiblePassword" android:singleLine="true"
                android:layout_marginBottom="24dp"/>

            <!-- CREATE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:text="@string/btn_create_database"
                android:backgroundTint="#FF6B00"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-black"
                android:textSize="16sp"
                android:letterSpacing="0.05"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
