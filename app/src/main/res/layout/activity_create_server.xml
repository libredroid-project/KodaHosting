<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header Container -->
    <LinearLayout android:id="@+id/top_bar_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1613" android:elevation="4dp">
        
        <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="20dp">
            <ImageButton android:id="@+id/btn_back"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FF6B00"
                android:scaleType="centerInside"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New Server" android:textColor="#F0F0F0"
                android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:textStyle="bold" android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FF6B00"/>

    <ScrollView android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- IMPORT BUTTONS -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import"
                    style="@style/KodaButton"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Import Folder"
                    android:backgroundTint="#1A1A24"
                    android:textColor="#8A8A9A"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2A2A35"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="10dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_zip"
                    style="@style/KodaButton"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Import ZIP"
                    android:backgroundTint="#1A1A24"
                    android:textColor="#8A8A9A"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2A2A35"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#1A1A24" android:layout_marginBottom="24dp"/>

            <!-- SERVER NAME -->
            <LinearLayout android:id="@+id/layout_name_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SERVER NAME" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_name"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/input_field"
                    android:textColor="#F0F0F0" android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:hint="e.g. MySurvival"
                    android:textColorHint="#3A3A48"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:inputType="text" android:singleLine="true"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- ADDRESS PREVIEW -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/preview_bg"
                android:padding="16dp" android:layout_marginBottom="20dp">
                <TextView android:id="@+id/tv_address_preview_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CONNECT ADDRESS" android:textColor="#8A8A9A"
                    android:textSize="10sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"/>
                <TextView android:id="@+id/tv_address_preview"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="yourserver.kodanetwork.eu"
                    android:textColor="#F0F0F0" android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/tv_velocity_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Velocity: kodanetwork.eu"
                    android:textColor="#555566" android:textSize="10sp"
                    android:fontFamily="sans-serif" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- SERVER TYPE -->
            <LinearLayout android:id="@+id/layout_type_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SERVER TYPE" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <NumberPicker android:id="@+id/np_server_type"
                    android:layout_width="match_parent" android:layout_height="120dp"
                    android:layout_marginBottom="20dp"
                    android:theme="@style/NumberPickerTheme"/>
            </LinearLayout>

                <!-- VERSION PICKER -->
                <LinearLayout android:id="@+id/layout_version_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VERSION" android:textColor="#F0F0F0"
                        android:textSize="11sp" android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_version_loading"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="..." android:textColor="#555566"
                        android:textSize="11sp" android:fontFamily="sans-serif"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_version_picker"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/tv_version_selected"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1.21.4" android:textColor="#F0F0F0"
                        android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▼" android:textColor="#FF6B00"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- RAM -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RAM" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"/>
                <TextView android:id="@+id/tv_ram_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F0F0F0" android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek_ram"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#FF6B00" android:thumbTint="#FF8C38"
                android:progressBackgroundTint="#1A1A24"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="512MB"
                    android:textColor="#555566" android:textSize="10sp"
                    android:fontFamily="sans-serif"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="8GB" android:textColor="#555566"
                    android:textSize="10sp" android:fontFamily="sans-serif"/>
            </LinearLayout>



            <!-- EXECUTION MODE -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/server_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Native Mode (Standalone)" android:textColor="#F0F0F0"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Direct in-app hosting (Experimental)"
                        android:textColor="#8A8A9A" android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_use_native"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:enabled="true"/>
            </LinearLayout>

            <!-- SETUP OPTION -->
            <LinearLayout android:id="@+id/layout_setup_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SETUP &amp; DESIGN" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <RadioGroup android:id="@+id/rg_setup_type"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="20dp"
                    android:background="@drawable/server_card_bg"
                    android:padding="16dp">
                    <RadioButton android:id="@+id/rb_setup_koda"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="KodaHosting Design (Auto TAB &amp; Theme)"
                        android:textColor="#F0F0F0" android:fontFamily="sans-serif"
                        android:textSize="13sp"
                        android:checked="true" android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                    <RadioButton android:id="@+id/rb_setup_manual"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Alles selbst machen (Clean Install)"
                        android:textColor="#F0F0F0" android:fontFamily="sans-serif"
                        android:textSize="13sp"
                        android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                    <RadioButton android:id="@+id/rb_setup_ai"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="AI Server Builder (BETA)"
                        android:textColor="#F0F0F0" android:fontFamily="sans-serif"
                        android:textSize="13sp"
                        android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"/> <!-- Made visible in code if karolbrz11212@gmail.com -->
                </RadioGroup>
            </LinearLayout>

            <!-- AI CHAT SECTION -->
            <LinearLayout android:id="@+id/layout_ai_prompt"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"
                android:layout_marginBottom="20dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI SERVER BUILDER CHAT" android:textColor="#F0F0F0"
                        android:textSize="11sp" android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1" android:layout_centerVertical="true"/>
                    <ImageButton android:id="@+id/btn_ai_fullscreen"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_crop" app:tint="#8A8A9A" />
                </RelativeLayout>
                
                <ScrollView android:id="@+id/sv_ai_chat"
                    android:layout_width="match_parent" android:layout_height="200dp"
                    android:background="@drawable/server_card_bg"
                    android:padding="8dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/ll_ai_chat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <EditText android:id="@+id/et_ai_prompt"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/input_field"
                        android:textColor="#F0F0F0" android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:hint="Talk to Gemini..."
                        android:textColorHint="#3A3A48"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:inputType="text" android:singleLine="true"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_send"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconTint="#FFFFFF"
                        app:backgroundTint="#FF6B00"
                        app:cornerRadius="12dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:padding="0dp"
                        android:insetTop="0dp" android:insetBottom="0dp"/>
                </LinearLayout>
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_approve"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="Approve Plan &amp; Create Server"
                    android:textSize="14sp" android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="12dp"
                    android:visibility="gone"/>
                
                <TextView android:id="@+id/tv_ai_chat_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Discuss your server idea. When you are happy with Gemini's plugin choices, click Approve."
                    android:textColor="#8A8A9A" android:textSize="11sp"
                    android:layout_marginTop="8dp" android:gravity="center_horizontal"/>
            </LinearLayout>

            <!-- THEME COLOR -->
            <LinearLayout android:id="@+id/layout_theme_color"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="THEME COLOR" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <LinearLayout android:id="@+id/btn_color_picker"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/color_picker_bg"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <View android:id="@+id/color_preview"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/color_preview_circle"
                        android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tv_color_hex"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="#FF6B00" android:textColor="#F0F0F0"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tap to change" android:textColor="#555566"
                        android:textSize="11sp" android:fontFamily="sans-serif"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CREATE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                style="@style/KodaButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Create Server"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:backgroundTint="#FF6B00"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- LOADING OVERLAY -->
    <FrameLayout
        android:id="@+id/layout_java_extract"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD0A0807"
        android:elevation="10dp"
        android:visibility="gone">
        
        <View
            android:id="@+id/java_extract_light_blob"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_light_blob"/>
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">
            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="#FF6B00"/>
            <TextView
                android:id="@+id/tv_extract_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Preparing Java..."
                android:textColor="#F0F0F0"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
