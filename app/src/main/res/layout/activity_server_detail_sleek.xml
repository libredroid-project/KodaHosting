<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sleek_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ═══ Header: Back + Server Info + Power ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/sleek_circle_dark"
            android:tint="@color/sleek_on_dark"
            android:padding="10dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_server_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server"
                android:textAppearance="@style/TextAppearance.Sleek.Title"
                android:textSize="20sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot_status"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/sleek_circle_dark"
                    android:backgroundTint="@color/sleek_success" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textSize="11sp"
                    android:textColor="@color/sleek_on_dark_muted"
                    android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.06"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_play"
            android:backgroundTint="@color/sleek_success"
            android:tint="@color/sleek_on_dark"
            app:fabCustomSize="48dp"
            app:maxImageSize="24dp"
            app:elevation="4dp"
            android:contentDescription="Start/Stop" />
    </LinearLayout>

    <!-- ═══ Pill Tab Bar ═══ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/sleek_pill_dark"
            android:backgroundTint="@color/sleek_surface"
            android:padding="4dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tab_dash"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/sleek_pill_accent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Dashboard"
                android:textColor="@color/sleek_on_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_console"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Console"
                android:textColor="@color/sleek_on_dark_muted"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_files"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Files"
                android:textColor="@color/sleek_on_dark_muted"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_mods"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Mods"
                android:textColor="@color/sleek_on_dark_muted"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Settings"
                android:textColor="@color/sleek_on_dark_muted"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ═══ Content Area ═══ -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Dashboard Tab -->
        <ScrollView
            android:id="@+id/panel_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- RAM Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/sleek_card_cream"
                    android:padding="20dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MEMORY"
                            android:textSize="11sp"
                            android:textColor="@color/sleek_on_cream_muted"
                            android:fontFamily="@font/font_koda"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_ram_usage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.5GB / 4GB"
                            android:textAppearance="@style/TextAppearance.Sleek.Stat"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- RAM Bar -->
                    <ProgressBar
                        android:id="@+id/pb_ram"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:progressTint="@color/sleek_accent"
                        android:progressBackgroundTint="@color/sleek_cream_3"
                        android:max="100"
                        android:progress="38" />
                </LinearLayout>

                <!-- Players + Info Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/sleek_card"
                        android:padding="16dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_players"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/20"
                            android:textAppearance="@style/TextAppearance.Sleek.Title"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLAYERS"
                            android:textSize="10sp"
                            android:textColor="@color/sleek_on_dark_muted"
                            android:fontFamily="@font/font_koda"
                            android:letterSpacing="0.08"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/sleek_card"
                        android:padding="16dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:id="@+id/tv_uptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0m"
                            android:textAppearance="@style/TextAppearance.Sleek.Title"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPTIME"
                            android:textSize="10sp"
                            android:textColor="@color/sleek_on_dark_muted"
                            android:fontFamily="@font/font_koda"
                            android:letterSpacing="0.08"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Join Address Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/sleek_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JOIN ADDRESS"
                            android:textSize="10sp"
                            android:textColor="@color/sleek_on_dark_muted"
                            android:fontFamily="@font/font_koda"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_join_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="server.kodanetwork.eu"
                            android:textColor="@color/sleek_accent"
                            android:textSize="14sp"
                            android:fontFamily="@font/font_koda_mono"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_copy_address"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/sleek_ic_copy"
                        android:background="@drawable/sleek_circle_dark"
                        android:tint="@color/sleek_on_dark_muted"
                        android:padding="8dp"
                        android:contentDescription="Copy" />
                </LinearLayout>

                <!-- Quick Actions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK ACTIONS"
                    android:textSize="11sp"
                    android:textColor="@color/sleek_on_dark_muted"
                    android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_restart"
                        style="@style/SleekButton.Dark"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Restart"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete"
                        style="@style/SleekButton.Dark"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Delete"
                        android:layout_marginStart="4dp"
                        app:strokeColor="@color/sleek_error"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Console Tab -->
        <LinearLayout
            android:id="@+id/panel_console"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <ScrollView
                android:id="@+id/sv_console"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/sleek_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_console"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_koda_mono"
                    android:textSize="11sp"
                    android:textColor="@color/sleek_on_dark_muted"
                    android:lineSpacingMultiplier="1.3" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/et_console_input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/sleek_input"
                    android:hint="Enter command..."
                    android:textColorHint="@color/sleek_on_dark_faint"
                    android:textColor="@color/sleek_on_dark"
                    android:textSize="13sp"
                    android:fontFamily="@font/font_koda_mono"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:imeOptions="actionSend" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@drawable/sleek_pill_accent"
                    android:tint="@color/sleek_on_dark"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Send" />
            </LinearLayout>
        </LinearLayout>

        <!-- Files / Mods / Settings placeholder panels -->
        <ScrollView
            android:id="@+id/panel_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Files (coming in sleek)"
                android:textColor="@color/sleek_on_dark_muted"
                android:gravity="center"
                android:padding="40dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/panel_mods"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mods (coming in sleek)"
                android:textColor="@color/sleek_on_dark_muted"
                android:gravity="center"
                android:padding="40dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/panel_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings (coming in sleek)"
                android:textColor="@color/sleek_on_dark_muted"
                android:gravity="center"
                android:padding="40dp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
