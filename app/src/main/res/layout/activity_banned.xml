<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <eu.kodanetwork.mchost.ui.FloatingSquaresView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="P.R.A.E.T.O.R."
            android:textColor="#FF3333"
            android:textSize="36sp"
            android:textStyle="bold"
            
             />

        <TextView
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT SUSPENDED"
            android:textColor="#8A8A9A"
            android:textSize="10sp"
            android:textStyle="bold"
            
            android:gravity="center"
            android:layout_marginTop="8dp" />
        
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#FF3333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/bannedReasonText"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your device has been permanently banned from the KodaHosting network due to violations of our terms of service."
            android:textSize="16sp"
            android:textColor="#cccccc"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/bannedHwidText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HWID: ..."
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular" />

    </LinearLayout>

</FrameLayout>
