<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <eu.kodanetwork.mchost.ui.FloatingSquaresView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="32dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textColor="#FF3333"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT SUSPENDED"
            android:textColor="#8A8A9A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:layout_marginTop="8dp" />
        
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#FF3333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your device has been permanently banned from the KodaHosting network due to violations of our terms of service."
            android:textSize="16sp"
            android:textColor="#cccccc"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/bannedHwidText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HWID: ..."
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="monospace" />

    </LinearLayout>

</FrameLayout>
