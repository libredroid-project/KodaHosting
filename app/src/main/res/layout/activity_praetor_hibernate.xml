<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#A6000000"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="16dp"
        android:gravity="center">

            <!-- Title: P.R.A.E.T.O.R. (Colors applied in Java) -->
            <TextView
                android:id="@+id/tv_praetor_title"
                android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="@string/praetor_title"
                android:textColor="#FF3333"
                android:textSize="36sp"
                android:textStyle="bold"
                
                 />

            <!-- Subtitle -->
            <TextView
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/praetor_subtitle"
                android:textColor="#8A8A9A"
                android:textSize="10sp"
                android:textStyle="bold"
                
                android:gravity="center"
                android:layout_marginTop="8dp" />
            
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="#FF6B00"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <!-- Warning Icon -->
            <TextView
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❄"
                android:textColor="#00BFFF"
                android:textSize="48sp"
                android:layout_marginBottom="16dp" />

            <!-- Reason Message -->
            <TextView
                android:id="@+id/tv_praetor_reason"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/praetor_hibernate_warning"
                android:textColor="#F0F0F0"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Long Explanation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_praetor_explanation"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/KodaButton.Outline"
                android:text="@string/praetor_hibernate_long_explanation"
                android:layout_marginBottom="24dp" />

            <!-- Countdown Timer -->
            <TextView
                android:id="@+id/tv_praetor_countdown"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFA500"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="10"
                android:layout_marginBottom="16dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_praetor_confirm"
                    android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
                    android:layout_height="56dp"
                    style="@style/KodaButton"
                    android:text="@string/praetor_hibernate_confirm"
                    app:backgroundTint="#00BFFF"
                    android:stateListAnimator="@null"
                    android:enabled="false"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_praetor_cancel"
                    android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
                    android:layout_height="56dp"
                    style="@style/KodaButton.Outline"
                    android:text="@string/praetor_hibernate_cancel"
                    android:stateListAnimator="@null" />
            </LinearLayout>

        </LinearLayout>
</LinearLayout>
