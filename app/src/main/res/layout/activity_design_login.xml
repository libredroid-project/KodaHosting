<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <eu.kodanetwork.mchost.ui.FloatingSquaresView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0A0A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:background="@drawable/bg_dialog_custom"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_praetor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P.R.A.E.T.O.R."
                android:textColor="#FF3333"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDENTIFICATION REQUIRED"
                android:textColor="#8A8A9A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="#FF6B00"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="@font/font_koda_mono"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1A1A1A"
                android:hint="user@network.local"
                android:inputType="textEmailAddress"
                android:textColor="#F0F0F0"
                android:textColorHint="#444444"
                android:fontFamily="@font/font_koda_mono"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PASSKEY"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="@font/font_koda_mono"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1A1A1A"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:textColor="#F0F0F0"
                android:textColorHint="#444444"
                android:fontFamily="@font/font_koda_mono"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cb_legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I accept the Terms of Service and Privacy Policy"
                android:textColor="#888888"
                android:textSize="12sp"
                android:buttonTint="#FF6B00"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_in"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/KodaButton.Danger"
                android:text="AUTHENTICATE"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/KodaButton.Outline"
                android:text="OAUTH PROTOCOL" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unregistered? "
                    android:textColor="#555555"
                    android:fontFamily="@font/font_koda_mono"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tv_create_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INITIALIZE"
                    android:textColor="#FF0000"
                    android:fontFamily="@font/font_koda_mono"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
