<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_custom"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_tickets_title"
        android:textColor="#FF8C00"
        android:textSize="18sp"
        android:fontFamily="@font/font_koda"
        android:letterSpacing="0.05"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/how_can_we_help"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:fontFamily="@font/font_koda"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <!-- Login Warning (Hidden by default) -->
    <LinearLayout
        android:id="@+id/ll_login_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#2A1608"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_logged_in"
            android:textColor="#FF6B00"
            android:textSize="14sp"
            android:fontFamily="@font/font_koda"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_warning_desc"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:textAlignment="center"/>
    </LinearLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Report Bug Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_bug"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/report_bug"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#241E1A"
            app:strokeColor="#FF6B00"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Report Server Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_server"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/report_server"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#241E1A"
            app:strokeColor="#FF6B00"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- My Tickets Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_my_tickets"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/support_tickets"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#16110D"
            app:strokeColor="#444444"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textColor="#888888"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"/>

</LinearLayout>
