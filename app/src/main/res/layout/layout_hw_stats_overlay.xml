<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#CC1A0D2A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/dev_purple"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hardware Stats"
                android:textColor="@color/dev_purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_koda"/>
                
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            
            <ImageView
                android:id="@+id/overlay_btn_close"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#888899"
                android:background="?selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_stat_arch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="Arch: ..."
            android:layout_marginBottom="4dp"/>
            
        <TextView
            android:id="@+id/tv_stat_ram_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="Total RAM: ..."
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_stat_ram_avail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="Avail RAM: ..."
            android:layout_marginBottom="4dp"/>
            
        <TextView
            android:id="@+id/tv_stat_heap_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="Dalvik Max: ..."/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
