<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/server_card_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="14dp" android:paddingBottom="14dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="4dp" android:layout_marginEnd="4dp">

    <!-- Status dot -->
    <View android:id="@+id/dot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/dot_offline"
        android:layout_marginEnd="14dp"/>

    <!-- Name + address -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F0F0F0" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_addr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#555566" android:textSize="11sp"
            android:fontFamily="sans-serif" android:layout_marginTop="2dp"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- Type -->
    <TextView android:id="@+id/tv_type"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F0F0F0" android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/type_badge_bg"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:layout_marginEnd="10dp"/>

    <!-- RAM -->
    <TextView android:id="@+id/tv_ram"
        android:layout_width="50dp" android:layout_height="wrap_content"
        android:textColor="#8A8A9A" android:textSize="11sp"
        android:fontFamily="sans-serif"/>

    <!-- Status badge -->
    <TextView android:id="@+id/tv_badge"
        android:layout_width="60dp" android:layout_height="wrap_content"
        android:textSize="10sp" android:fontFamily="sans-serif-medium"
        android:textStyle="bold" android:letterSpacing="0.03"/>

    <!-- Hidden views for compat -->
    <TextView android:id="@+id/tv_ver"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:visibility="gone"/>
    <TextView android:id="@+id/tv_players"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:visibility="gone"/>

</LinearLayout>
