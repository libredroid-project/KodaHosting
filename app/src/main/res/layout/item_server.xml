<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <!-- Card flush with edges, no margin, no rounded corners -->
    <LinearLayout
        android:id="@+id/container_main"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A0807"
        android:minHeight="136dp">

        <!-- ════════ LEFT PANEL: Status Accent ════════ -->
        <LinearLayout
            android:id="@+id/left_panel"
            android:layout_width="80dp" android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A2E1A"
            android:padding="10dp">

            <!-- Server Icon -->
            <ImageView android:id="@+id/iv_server_icon"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/server_icon_bg"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp" />

            <!-- Status Dot -->
            <View android:id="@+id/dot"
                android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/dot_offline"
                android:layout_marginBottom="4dp" />

            <!-- Status Text -->
            <TextView android:id="@+id/tv_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OFFLINE" android:textColor="#8A8A9A"
                android:textSize="9sp" android:fontFamily="@font/font_koda"
                android:textStyle="bold" android:letterSpacing="0.05"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- TPS in left panel (was battery) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TPS" android:textColor="#555566"
                android:textSize="8sp" android:fontFamily="@font/font_koda"
                android:letterSpacing="0.1" android:layout_marginBottom="2dp" />
            <TextView android:id="@+id/tv_tps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="20.0" android:textColor="#00E676"
                android:textSize="15sp" android:fontFamily="@font/font_koda"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ════════ RIGHT PANEL: Info + Action ════════ -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#131110"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="12dp" android:paddingBottom="12dp">

            <!-- Server Name -->
            <TextView android:id="@+id/tv_name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Survival with friends" android:textColor="#F0F0F0"
                android:textSize="17sp" android:fontFamily="@font/font_koda"
                android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- Version / Players / Uptime subtitle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView android:id="@+id/tv_ver"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pumpkin 1.21.11 • 5 players" android:textColor="#8A8A9A"
                    android:textSize="12sp" android:fontFamily="@font/font_koda"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" • " android:textColor="#8A8A9A"
                    android:textSize="12sp" android:fontFamily="@font/font_koda" />
                <TextView android:id="@+id/tv_uptime"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--:--" android:textColor="#8A8A9A"
                    android:textSize="12sp" android:fontFamily="@font/font_koda"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <!-- Address row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#555566"
                    android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/tv_addr"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="elite-bee-17.arm-mc.com" android:textColor="#666677"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <!-- Stats row: RAM + Uptime -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- RAM compact -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginEnd="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RAM" android:textColor="#555566"
                            android:textSize="9sp" android:fontFamily="@font/font_koda"
                            android:letterSpacing="0.1" android:layout_marginEnd="6dp" />
                        <TextView android:id="@+id/tv_ram"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1.3 / 1.9GB" android:textColor="#CCCCCC"
                            android:textSize="11sp" android:fontFamily="@font/font_koda" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/pb_ram"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="3dp"
                        android:progressDrawable="@drawable/custom_progress_bar"
                        android:progress="68" android:max="100" />
                </LinearLayout>

            </LinearLayout>

            <!-- Action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action"
                android:layout_width="match_parent" android:layout_height="40dp"
                android:text="STOP"
                android:textColor="#111111" android:textSize="13sp"
                android:fontFamily="@font/font_koda" android:textStyle="bold"
                app:backgroundTint="#FF5252" app:cornerRadius="20dp"
                android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Divider line between cards -->
    <View android:id="@+id/divider"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1A1A24"
        android:layout_gravity="bottom" />

    <!-- Hidden views to prevent crash -->
    <TextView android:id="@+id/tv_type" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tv_players" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <!-- Keep battery views as hidden stubs so adapter doesn't crash -->
    <ProgressBar android:id="@+id/pb_battery" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        android:max="100" />
    <TextView android:id="@+id/tv_battery" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</FrameLayout>
