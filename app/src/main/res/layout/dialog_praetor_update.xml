<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_dialog_custom"
    android:gravity="center">

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        
        android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="@string/praetor_title"
        android:textColor="#FF3333"
        android:textSize="36sp"
        android:textStyle="bold"
         />

    <TextView
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/praetor_subtitle"
        android:textColor="#8A8A9A"
        android:textSize="10sp"
        android:textStyle="bold"
        
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="#FF6B00"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvUpdateSubtitle"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/praetor_update_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateMessage"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/praetor_update_message"
        android:textColor="#F0F0F0"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateNow"
            style="@style/KodaButton"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            app:backgroundTint="#FF6B00"
            android:stateListAnimator="@null"
            android:text="@string/praetor_update_button"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateSkip"
            style="@style/KodaButton.Outline"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            android:stateListAnimator="@null"
            android:enabled="false"
            android:text="@string/praetor_update_skip" />

    </LinearLayout>

</LinearLayout>
