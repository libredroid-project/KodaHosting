<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#A6000000"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_praetor_title"
            android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="P.R.A.E.T.O.R."
            android:textColor="#FF3333"
            android:textSize="36sp"
            android:textStyle="bold"
            
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/praetor_subtitle"
            android:textColor="#555555"
            android:textSize="14sp"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
            android:textStyle="normal"
            
            android:gravity="center"
            android:layout_marginTop="8dp" />
        
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#FF6B00"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_warning_icon"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="#FF3333"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tv_explanation"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You are about to delete all servers."
                android:textColor="#F0F0F0"
                android:textSize="16sp"
                android:gravity="center" />
        </ScrollView>



        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="#FF3333" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK: "
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular" />
                
            <TextView
                android:id="@+id/tv_network_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECKING..."
                android:textColor="#FF8800"
                android:textSize="12sp"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_countdown"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10"
            android:textColor="#FF3333"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton.Danger"
            android:text="CONFIRM"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/KodaButton.Outline"
                android:text="ABORT" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
