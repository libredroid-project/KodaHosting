<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0807"
    android:paddingBottom="48dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/players_manage_title"
        android:textColor="#FF6B00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222230" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Online Section -->
            <TextView
                android:id="@+id/tv_pm_online_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/players_online"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:paddingStart="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/container_pm_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card"
                android:padding="8dp"
                android:visibility="gone"/>

            <!-- Offline Section -->
            <TextView
                android:id="@+id/tv_pm_offline_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/players_offline_known"
                android:textColor="#888899"
                android:textSize="12sp"
                android:paddingStart="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/container_pm_offline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card"
                android:padding="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
