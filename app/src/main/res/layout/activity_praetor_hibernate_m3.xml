<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#A6000000"
    android:gravity="center"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="32dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="32dp"
        android:gravity="center">

            <!-- Title: P.R.A.E.T.O.R. (Colors applied in Java) -->
            <TextView
                android:id="@+id/tv_praetor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/praetor_title"
                android:textColor="?attr/colorError"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/praetor_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:layout_marginTop="8dp" />
            
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="?attr/colorPrimary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <!-- Warning Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❄"
                android:textColor="#00BFFF"
                android:textSize="48sp"
                android:layout_marginBottom="16dp" />

            <!-- Reason Message -->
            <TextView
                android:id="@+id/tv_praetor_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/praetor_hibernate_warning"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Long Explanation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_praetor_explanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="@string/praetor_hibernate_long_explanation"
                android:layout_marginBottom="24dp" />

            <!-- Countdown Timer -->
            <TextView
                android:id="@+id/tv_praetor_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFA500"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="10"
                android:layout_marginBottom="16dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_praetor_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    style="@style/Widget.Material3.Button"
                    android:text="@string/praetor_hibernate_confirm"
                    app:backgroundTint="#00BFFF"
                    android:stateListAnimator="@null"
                    android:enabled="false"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_praetor_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="@string/praetor_hibernate_cancel"
                    android:stateListAnimator="@null" />
            </LinearLayout>

        </LinearLayout>
</LinearLayout>
