<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_custom"
    android:padding="16dp"
    android:gravity="center">

    <!-- Title: P.R.A.E.T.O.R. -->
    <TextView
        android:id="@+id/tv_praetor_title"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="@string/praetor_title"
        android:textColor="#FF3333"
        android:textSize="28sp"
        android:textStyle="bold"
        
         />

    <!-- Subtitle -->
    <TextView
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/praetor_subtitle"
        android:textColor="#8A8A9A"
        android:textSize="10sp"
        android:textStyle="bold"
        
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="#FF6B00"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Addon Title -->
    <TextView
        android:id="@+id/tv_addon_title"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:text="BEDROCK SUPPORT"
        android:textColor="#F0F0F0" 
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" 
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:id="@+id/layout_addon_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_addon_toggle"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton"
            android:text="TURN OFF"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_addon_change_domain"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton.Outline"
            android:text="CHANGE DOMAIN"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_addon_unlink_domain"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton.Danger"
            android:text="UNLINK DOMAIN"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_addon_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/tv_addon_warning_text"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tv_addon_countdown"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFA500"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_addon_confirm_off"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton.Danger"
            android:text="CONFIRM DISABLE"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_addon_cancel"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/KodaButton.Outline"
            android:text="CANCEL"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
