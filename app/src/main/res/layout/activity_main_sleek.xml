<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sleek_bg"
    android:fitsSystemWindows="true">

    <!-- ═══ Main Content ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/sleek_circle_dark"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KodaHosting"
                    android:textAppearance="@style/TextAppearance.Sleek.Headline"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_server_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 SERVERS"
                    android:textAppearance="@style/TextAppearance.Sleek.Caption"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sleek_ic_gear"
                android:background="@drawable/sleek_circle_dark"
                android:tint="@color/sleek_on_dark_muted"
                android:padding="10dp"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- Quick Stats Cream Card -->
        <LinearLayout
            android:id="@+id/card_quick_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/sleek_card_cream"
            android:padding="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_stat_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.Sleek.Stat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVERS"
                    android:textSize="10sp"
                    android:textColor="@color/sleek_on_cream_muted"
                    android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/sleek_cream_3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_stat_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.Sleek.Stat"
                    android:textColor="@color/sleek_success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textSize="10sp"
                    android:textColor="@color/sleek_on_cream_muted"
                    android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/sleek_cream_3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_stat_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0GB"
                    android:textAppearance="@style/TextAppearance.Sleek.Stat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM"
                    android:textSize="10sp"
                    android:textColor="@color/sleek_on_cream_muted"
                    android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- Server List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="120dp"
            android:clipToPadding="false" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/sleek_ic_server"
                android:tint="@color/sleek_on_dark_faint"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Servers Yet"
                android:textAppearance="@style/TextAppearance.Sleek.Title"
                android:textColor="@color/sleek_on_dark_muted"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap + to create your first server"
                android:textAppearance="@style/TextAppearance.Sleek.Body"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Floating Bottom Nav with FAB ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Nav bar -->
        <LinearLayout
            android:id="@+id/main_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:background="@drawable/sleek_nav_pill"
            android:gravity="center_vertical"
            android:elevation="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/sleek_ic_server"
                android:tint="@color/sleek_accent"
                android:padding="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Servers" />

            <ImageView
                android:id="@+id/nav_log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/sleek_ic_activity"
                android:tint="@color/sleek_on_dark_muted"
                android:padding="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Console" />

            <Space
                android:layout_width="68dp"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/sleek_ic_gear"
                android:tint="@color/sleek_on_dark_muted"
                android:padding="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- Central FAB: protrudes above nav -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal|top"
            android:src="@android:drawable/ic_input_add"
            android:backgroundTint="@color/sleek_accent"
            android:tint="@color/sleek_on_dark"
            app:elevation="16dp"
            app:fabCustomSize="64dp"
            app:maxImageSize="32dp"
            app:borderWidth="6dp"
            app:rippleColor="#33F0762B"
            android:contentDescription="New Server" />
    </FrameLayout>
</FrameLayout>
