<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <eu.kodanetwork.mchost.ui.FloatingSquaresView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/bg_dialog_custom"
        android:padding="32dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:text="P.R.A.E.T.O.R."
            android:textColor="#FF6B00"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
             />

        <TextView
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAINTENANCE PROTOCOL"
            android:textColor="#8A8A9A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:layout_marginTop="8dp" />
        
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#FF6B00"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/maintenanceReasonText"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We are currently upgrading our systems."
            android:textSize="16sp"
            android:textColor="#cccccc"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/maintenanceDurationText"
            android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated duration: 60 minutes"
            android:textSize="14sp"
            android:textColor="#FF6B00"
            android:textStyle="italic" />

    </LinearLayout>
</FrameLayout>
