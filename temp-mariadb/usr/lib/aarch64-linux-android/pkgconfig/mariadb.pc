# these four variables are present in almost every .pc file
prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-android
includedir=${prefix}/include/mariadb
# its common to want to know where to install it.
plugindir=${prefix}/lib/mysql/plugin
# Below are rarely present or not at all, but we export them regardless
bindir=${prefix}/bin
sbindir=${prefix}//data/data/com.termux/files/usr/bin
scriptdir=${prefix}/bin
docdir=${prefix}/share/doc
mandir=${prefix}/share/man
sharedir=${prefix}/share
mysqlsharedir=${prefix}/share/mariadb
mysqltestdir=${prefix}/share/mariadb/mariadb-test
socket=/data/data/com.termux/files/usr/var/run/mysqld.sock

Name: MariaDB
Description: MariaDB: a very fast and robust SQL database server
URL: http://mariadb.org
Version: 12.3.2
Libs: -L${libdir} -lmariadb
Cflags: -I${includedir} 
