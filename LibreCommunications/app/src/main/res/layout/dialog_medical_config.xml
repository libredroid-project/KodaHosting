<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure Medical ID"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etBloodType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Blood Type (e.g. O-)"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF6B00" />

    <EditText
        android:id="@+id/etAllergies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Allergies"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF6B00"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etEmergencyContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Emergency Contact Phone"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF6B00"
        android:inputType="phone"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etConditions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Medical Conditions"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF6B00"
        android:layout_marginTop="8dp" />

</LinearLayout>
