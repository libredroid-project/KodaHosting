    <string name="onboarding_permission_camera_title">Camera Permission</string>
    <string name="onboarding_permission_location_body">Required for Bluetooth and Wi-Fi Direct device discovery. Your location is never sent to any server.</string>
    <string name="onboarding_permission_location_title">Location Permission</string>
    <string name="onboarding_permission_notification_body">Receive alerts for incoming messages and emergency broadcasts.</string>
    <string name="onboarding_permission_notification_title">Notification Permission</string>
    <string name="onboarding_privacy_body">Libre Communications collects no metadata, stores no logs, and requires no phone number or email. Your identity is a cryptographic key pair generated on your device.</string>
