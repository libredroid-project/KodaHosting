    <string name="onboarding_manifesto_body">We exist because Chat Control threatens your fundamental right to private communication. Libre Communications is built for a world where governments scan your messages, where backdoors are mandated by law, and where speaking freely is treated as suspicious.\n\nEvery message you send is end-to-end encrypted. We cannot read it. No government can read it. No corporation can monetize it.\n\nYour keys. Your data. Your voice.</string>
    <string name="onboarding_manifesto_title">Our Promise</string>
    <string name="onboarding_mesh_body">When the internet goes down, Libre keeps working. Connect peer-to-peer over Bluetooth, Wi-Fi Direct, or local mesh networks. No servers required.</string>
    <string name="onboarding_mesh_title">Beyond the Grid</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_permission_bluetooth_body">Used for peer-to-peer mesh communication when no internet is available.</string>
